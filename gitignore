# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editors / IDEs
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-workspace

# Env / secrets / direnv
.env
.env.local
.envrc.local
.direnv/

# Logs & temp
*.log
*.tmp

