# Managed by ~/code/init (github: tarballz/init) — symlinked to ~/.gitconfig.
# Behavioral config only. Per-machine identity + secrets live in ~/.gitconfig.local
# (git-ignored), sourced via the [include] at the bottom.

[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[pull]
	rebase = false
[fetch]
	prune = true
	pruneTags = true
[rebase]
	autoStash = true
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
[rerere]
	enabled = true
[core]
	excludesfile = ~/.config/git/ignore
	fsmonitor = true
	untrackedCache = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[help]
	autocorrect = prompt

# SSH commit signing using the existing ed25519 key.
# Register the public key as a *signing* key on GitHub:
#   gh ssh-key add ~/.ssh/id_ed25519.pub --type signing
[gpg]
	format = ssh
[user]
	signingkey = ~/.ssh/id_ed25519.pub
[commit]
	gpgsign = true
[tag]
	sort = version:refname
	gpgsign = true

# Per-machine identity + overrides (git-ignored, never committed).
# Must contain at least:  [user]\n\tname = ...\n\temail = ...
[include]
	path = ~/.gitconfig.local
